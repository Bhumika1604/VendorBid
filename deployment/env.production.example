#--------------------------------------------------------------------
# VendorBid — PRODUCTION Environment Configuration (Hostinger)
#--------------------------------------------------------------------
# Copy this file to the project root as ".env" on your Hostinger server
# (via File Manager or SFTP) and fill in the real values below.
# Never commit a real, filled-in .env file to GitHub.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Replace with your actual domain. Include the trailing slash.
app.baseURL = 'https://yourdomain.com/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE
# Get these values from Hostinger hPanel → Databases → MySQL Databases
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = u123456789_vendorbid
database.default.username = u123456789_vbuser
database.default.password = CHANGE_ME_STRONG_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
# Generate a fresh key on the server with:
#   php spark key:generate
# then paste the value it outputs below (keep the "hex2bin:" prefix).
#--------------------------------------------------------------------
encryption.key = hex2bin:CHANGE_ME_GENERATE_WITH_SPARK_KEY_GENERATE

#--------------------------------------------------------------------
# EMAIL (SMTP) — used by the Bid Submitted / Award / Rejection emails
# Hostinger Titan Mail example values shown; adjust to your provider.
#--------------------------------------------------------------------
email.protocol   = smtp
email.SMTPHost    = smtp.hostinger.com
email.SMTPUser    = no-reply@yourdomain.com
email.SMTPPass    = CHANGE_ME_MAILBOX_PASSWORD
email.SMTPPort    = 587
email.SMTPCrypto  = tls
email.mailType    = html
email.fromEmail   = no-reply@yourdomain.com
email.fromName    = VendorBid

#--------------------------------------------------------------------
# SESSION (optional hardening for shared hosting)
#--------------------------------------------------------------------
session.driver         = CodeIgniter\Session\Handlers\FileHandler
session.cookieSecure   = true
session.expiration     = 7200

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------
logger.threshold = 4
